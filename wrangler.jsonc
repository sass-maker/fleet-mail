{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fleet-mail",
	"account_id": "7d048325699a5acddb44d3be31cf6ba9",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-27",
	"compatibility_flags": [
		"nodejs_compat",
		"enable_nodejs_http_modules"
	],
	"workers_dev": true,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "mail.significanthobbies.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"vars": {
		"EMAIL_PROVIDER": "cloudflare",
		"CLOUDFLARE_MAIL_DOMAINS": "aliveville.com,codevetter.com,daddyrad.com,heypace.app,highsignal.app,karte.cc,posttrainllm.com,rolepatch.com,sarthakagrawal.dev,sassmaker.com,significanthobbies.com",
		"API_SEND_ENABLED": "false",
		"ACCESS_TEAM_DOMAIN": "https://long-frog-c8a6.cloudflareaccess.com",
		"ACCESS_AUD": "7640cf667275edec959f017d47e84a675681f62fc409e3771d0c54731bbe7a80",
		"ACCESS_OWNER_EMAIL": "sarthakagrawal927@gmail.com",
		"APP_URL": "https://mail.significanthobbies.com"
	},
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fleet-mail",
			"database_id": "ae8e598f-cee1-483a-b86d-f1f6055c22ee",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "fleet-mail-attachments"
		}
	],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	}
}
